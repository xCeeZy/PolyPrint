<Page x:Class="PolyPrint.View.Pages.AddOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PolyPrint.View.Pages"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Заказы"
      Tag="Создавайте новые заказы и отслеживайте текущие по статусу и общей сумме.">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Новый заказ"
                               Style="{StaticResource SectionTitleTextBlockStyle}"/>
                    <TextBlock Text="Заполните данные заказа, выберите клиента и укажите статус."
                               Style="{StaticResource CaptionTextBlockStyle}"/>

                    <UniformGrid Columns="2" Margin="0,24,0,0">
                        <StackPanel Margin="0,0,24,16">
                            <TextBlock Text="Клиент" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ClientComboBox"
                                      DisplayMemberPath="Organization_Name"
                                      SelectedValuePath="ID_Client"
                                      MinWidth="200"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Дата заказа" FontWeight="SemiBold"/>
                            <DatePicker x:Name="OrderDatePicker" SelectedDate="{x:Static sys:DateTime.Today}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Статус" FontWeight="SemiBold"/>
                            <ComboBox x:Name="StatusComboBox" MinWidth="200"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Сумма, ₽" FontWeight="SemiBold"/>
                            <TextBox x:Name="TotalTextBox" MinWidth="200"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,24,0,0">
                        <Button Content="Очистить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="140"
                                Click="ClearOrderForm_Click"/>
                        <Button Content="Сохранить заказ"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="200"
                                Margin="12,0,0,0"
                                Click="SaveOrderButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,32,0,0">
                <StackPanel>
                    <TextBlock Text="Текущие заказы"
                               Style="{StaticResource SectionTitleTextBlockStyle}"/>
                    <DataGrid x:Name="OrdersGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding ID}" Width="80"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding Client}" Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=d}" Width="150"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="160"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat=N2}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
