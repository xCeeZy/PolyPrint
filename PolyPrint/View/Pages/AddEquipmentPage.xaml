<Page x:Class="PolyPrint.View.Pages.AddEquipmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PolyPrint.View.Pages"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Оборудование"
      Tag="Ведите учет устройств клиентов, чтобы быстрее формировать заявки и работы.">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Добавление оборудования"
                               Style="{StaticResource SectionTitleTextBlockStyle}"/>
                    <TextBlock Text="Заполните основные характеристики и укажите клиента."
                               Style="{StaticResource CaptionTextBlockStyle}"/>

                    <UniformGrid Columns="2" Margin="0,24,0,0">
                        <StackPanel Margin="0,0,24,16">
                            <TextBlock Text="Название" FontWeight="SemiBold"/>
                            <TextBox x:Name="NameTextBox" MinWidth="200"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Модель" FontWeight="SemiBold"/>
                            <TextBox x:Name="ModelTextBox" MinWidth="200"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Серийный номер" FontWeight="SemiBold"/>
                            <TextBox x:Name="SerialTextBox" MinWidth="200"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Клиент" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ClientComboBox"
                                      DisplayMemberPath="Organization_Name"
                                      SelectedValuePath="ID_Client"
                                      MinWidth="200"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Состояние" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ConditionComboBox" IsEditable="True" MinWidth="200"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,24,0,0">
                        <Button Content="Очистить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="140"
                                Click="ClearEquipmentForm_Click"/>
                        <Button Content="Сохранить оборудование"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="220"
                                Margin="12,0,0,0"
                                Click="SaveEquipmentButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,32,0,0">
                <StackPanel>
                    <TextBlock Text="Каталог оборудования"
                               Style="{StaticResource SectionTitleTextBlockStyle}"/>
                    <DataGrid x:Name="EquipmentGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="80"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                            <DataGridTextColumn Header="Серийный номер" Binding="{Binding Serial}" Width="*"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding Client}" Width="*"/>
                            <DataGridTextColumn Header="Состояние" Binding="{Binding Condition}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
