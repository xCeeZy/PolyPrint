<Page x:Class="PolyPrint.View.Pages.AddWorkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PolyPrint.View.Pages"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Работы"
      Tag="Ведите учет выполненных работ по заявкам и рассчитывайте стоимость услуг.">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Добавление работы"
                               Style="{StaticResource SectionTitleTextBlockStyle}"/>
                    <TextBlock Text="Выберите заявку, опишите выполненные действия и укажите итоговую стоимость."
                               Style="{StaticResource CaptionTextBlockStyle}"/>

                    <UniformGrid Columns="2" Margin="0,24,0,0">
                        <StackPanel Margin="0,0,24,16">
                            <TextBlock Text="Заявка" FontWeight="SemiBold"/>
                            <ComboBox x:Name="RequestComboBox"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Request"
                                      MinWidth="220"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Дата выполнения" FontWeight="SemiBold"/>
                            <DatePicker x:Name="WorkDatePicker" SelectedDate="{x:Static sys:DateTime.Today}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Стоимость, ₽" FontWeight="SemiBold"/>
                            <TextBox x:Name="CostTextBox" MinWidth="200"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Описание выполненных работ" FontWeight="SemiBold"/>
                        <TextBox x:Name="DescriptionTextBox"
                                 AcceptsReturn="True"
                                 Height="100"
                                 TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,24,0,0">
                        <Button Content="Очистить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="140"
                                Click="ClearWorkForm_Click"/>
                        <Button Content="Сохранить работу"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="200"
                                Margin="12,0,0,0"
                                Click="SaveWorkButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,32,0,0">
                <StackPanel>
                    <TextBlock Text="Выполненные работы"
                               Style="{StaticResource SectionTitleTextBlockStyle}"/>
                    <DataGrid x:Name="WorksGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="80"/>
                            <DataGridTextColumn Header="Заявка" Binding="{Binding Request}" Width="140"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding Client}" Width="*"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=d}" Width="140"/>
                            <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost, StringFormat=N2}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
