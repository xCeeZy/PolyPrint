<Page x:Class="PolyPrint.View.Pages.JournalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PolyPrint.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="JournalPage" Background="PeachPuff">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="800"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Журнал данных" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <ComboBox x:Name="TableSelector"
                      Grid.Column="1"
                      Width="180" Height="28"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      SelectionChanged="TableSelector_SelectionChanged">
                <ComboBoxItem Content="Заказы"/>
                <ComboBoxItem Content="Заявки"/>
                <ComboBoxItem Content="Работы"/>
            </ComboBox>
        </Grid>

        <DataGrid x:Name="MainGrid"
                  Grid.Row="1" Grid.Column="1"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="All"/>
    </Grid>
</Page>