<Window x:Class="PolyPrint.View.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolyPrint.View.Windows"
        mc:Ignorable="d"
        Title="Авторизация" 
        Height="480" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <!--#region Определение структуры-->
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->

        <!--#region Заголовок-->
        <Border Grid.Row="0" 
                Background="{StaticResource HeaderBackgroundBrush}">
            <StackPanel VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <TextBlock Text="PolyPrint" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="{StaticResource HeaderTextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Система управления печатью" 
                           FontSize="12" 
                           Foreground="{StaticResource HeaderTextBrush}"
                           Opacity="0.8"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <!--#endregion-->

        <!--#region Форма авторизации-->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Margin="40,25,40,35">
            <Border.Effect>
                <DropShadowEffect Color="Gray" 
                                  BlurRadius="15" 
                                  ShadowDepth="3" 
                                  Opacity="0.3"/>
            </Border.Effect>

            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--#region Поле логина-->
                <TextBlock Grid.Row="0" 
                           Text="Логин" 
                           Style="{StaticResource LabelTextStyle}"/>

                <Border Grid.Row="2"
                        Style="{StaticResource InputBorderStyle}">
                    <TextBox x:Name="LoginTextBox"
                             Style="{StaticResource InputTextBoxStyle}"/>
                </Border>
                <!--#endregion-->

                <!--#region Поле пароля-->
                <TextBlock Grid.Row="4" 
                           Text="Пароль" 
                           Style="{StaticResource LabelTextStyle}"/>

                <Border Grid.Row="6"
                        Style="{StaticResource InputBorderStyle}">
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource InputPasswordBoxStyle}"/>
                </Border>
                <!--#endregion-->

                <!--#region Кнопка входа-->
                <Button x:Name="LoginButton"
                        Grid.Row="8"
                        Content="Войти"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="45"/>
                <!--#endregion-->
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</Window>
<!--#endregion-->