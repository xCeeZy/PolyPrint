<Window x:Class="PolyPrint.View.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolyPrint"
        mc:Ignorable="d"
        Title="PolyPrint" Width="900" Height="550" WindowStartupLocation="CenterScreen" Background="PeachPuff">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" Grid.Row="0" Background="#D59F72">
            <TextBlock Text="PolyPrint — система управления" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Background="#D8B899">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Button x:Name="ClientsButton" Grid.Row="0" Content="Клиенты" Height="40" Width="160" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ClientsButton_Click"/>
            <Button x:Name="OrdersButton" Grid.Row="1" Content="Заказы" Height="40" Width="160" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OrdersButton_Click"/>
            <Button x:Name="EquipmentButton" Grid.Row="2" Content="Оборудование" Height="40" Width="160" HorizontalAlignment="Center" VerticalAlignment="Center" Click="EquipmentButton_Click"/>
            <Button x:Name="ServiceButton" Grid.Row="3" Content="Сервисные заявки" Height="40" Width="160" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ServiceButton_Click"/>
            <Button x:Name="PartsButton" Grid.Row="4" Content="Запчасти" Height="40" Width="160" HorizontalAlignment="Center" VerticalAlignment="Center" Click="PartsButton_Click"/>
            <Button x:Name="JournalButton" Grid.Row="5" Content="Журнал" Height="40" Width="160" HorizontalAlignment="Center" VerticalAlignment="Center" Click="JournalButton_Click"/>
        </Grid>

        <Frame x:Name="MainFrame" Grid.Row="1" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>