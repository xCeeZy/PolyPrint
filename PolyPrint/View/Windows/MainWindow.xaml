<Window x:Class="PolyPrint.View.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolyPrint"
        mc:Ignorable="d"
        Title="PolyPrint" 
        Width="900" 
        Height="550" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize"
        MinWidth="800"
        MinHeight="500"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <!--#region Определение структуры-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->

        <!--#region Шапка приложения-->
        <Border Grid.ColumnSpan="2" 
                Grid.Row="0" 
                Background="{StaticResource HeaderBackgroundBrush}">
            <TextBlock Text="PolyPrint — система управления" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       FontSize="20" 
                       FontWeight="Bold"
                       Foreground="{StaticResource HeaderTextBrush}"/>
        </Border>
        <!--#endregion-->

        <!--#region Боковое меню-->
        <Grid Grid.Row="1" 
              Grid.Column="0" 
              Background="{StaticResource MenuBackgroundBrush}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button x:Name="ClientsButton" 
                    Grid.Row="0" 
                    Content="Клиенты"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="20,20,20,10"/>

            <Button x:Name="OrdersButton" 
                    Grid.Row="1" 
                    Content="Заказы"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="20,10,20,10"/>

            <Button x:Name="EquipmentButton" 
                    Grid.Row="2" 
                    Content="Оборудование"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="20,10,20,10"/>

            <Button x:Name="ServiceButton" 
                    Grid.Row="3" 
                    Content="Сервисные заявки"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="20,10,20,10"/>

            <Button x:Name="PartsButton" 
                    Grid.Row="4" 
                    Content="Запчасти"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="20,10,20,10"/>

            <Button x:Name="JournalButton" 
                    Grid.Row="5" 
                    Content="Журнал"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="20,10,20,10"/>
        </Grid>
        <!--#endregion-->

        <!--#region Область контента-->
        <Frame x:Name="MainFrame" 
               Grid.Row="1" 
               Grid.Column="1" 
               NavigationUIVisibility="Hidden"
               Background="{StaticResource ContentBackgroundBrush}"/>
        <!--#endregion-->
    </Grid>
</Window>
<!--#endregion-->
