<Window x:Class="PolyPrint.View.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolyPrint"
        mc:Ignorable="d"
        Title="PolyPrint"
        Width="1100"
        Height="700"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                Padding="32"
                CornerRadius="28,0,0,28"
                SnapsToDevicePixels="True">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="PolyPrint"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Управление сервисным центром"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <Separator/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                    <Button x:Name="JournalButton"
                            Content="Журнал"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="JournalButton_Click"/>
                    <Button x:Name="ClientsButton"
                            Content="Клиенты"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="ClientsButton_Click"/>
                    <Button x:Name="OrdersButton"
                            Content="Заказы"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="OrdersButton_Click"/>
                    <Button x:Name="EquipmentButton"
                            Content="Оборудование"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="EquipmentButton_Click"/>
                    <Button x:Name="ServiceButton"
                            Content="Сервисные заявки"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="ServiceButton_Click"/>
                    <Button x:Name="WorksButton"
                            Content="Работы"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="WorksButton_Click"/>
                    <Button x:Name="PartsButton"
                            Content="Запчасти"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Click="PartsButton_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0">
                    <Separator/>
                    <TextBlock Text="Советы"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Используйте навигацию слева, чтобы добавлять клиентов, оборудование и управлять сервисными заявками."
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <Button Content="О программе"
                            Style="{StaticResource SidebarNavigationButtonStyle}"
                            Margin="0,16,0,0"
                            Click="AboutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="24"
                    CornerRadius="24">
                <Border.Effect>
                    <DropShadowEffect Color="#26000000" BlurRadius="14" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="PageTitleTextBlock"
                               Style="{StaticResource SectionTitleTextBlockStyle}"
                               Text="Раздел"/>
                    <TextBlock x:Name="PageSubtitleTextBlock"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="Краткое описание текущего раздела"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="28"
                    Margin="0,24,0,0"
                    Padding="0"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#26000000" BlurRadius="18" ShadowDepth="0"/>
                </Border.Effect>
                <Frame x:Name="MainFrame"/>
            </Border>
        </Grid>
    </Grid>
</Window>
