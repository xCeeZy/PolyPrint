<Window x:Class="PolyPrint.View.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolyPrint"
        mc:Ignorable="d"
        Title="PolyPrint" Width="900" Height="550" WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2"
                Grid.Row="0"
                Background="{StaticResource HeaderBackgroundBrush}"
                Margin="0,0,0,16"
                CornerRadius="16,16,0,0">
            <TextBlock Text="PolyPrint — система управления"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource HeaderForegroundBrush}"/>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                Margin="0,0,16,0"
                Padding="16"
                CornerRadius="16,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="ClientsButton" Grid.Row="0" Content="Клиенты" Width="160" HorizontalAlignment="Center" Click="ClientsButton_Click"/>
                <Button x:Name="OrdersButton" Grid.Row="1" Content="Заказы" Width="160" HorizontalAlignment="Center" Margin="0,12,0,0" Click="OrdersButton_Click"/>
                <Button x:Name="EquipmentButton" Grid.Row="2" Content="Оборудование" Width="160" HorizontalAlignment="Center" Margin="0,12,0,0" Click="EquipmentButton_Click"/>
                <Button x:Name="ServiceButton" Grid.Row="3" Content="Сервисные заявки" Width="160" HorizontalAlignment="Center" Margin="0,12,0,0" Click="ServiceButton_Click"/>
                <Button x:Name="PartsButton" Grid.Row="4" Content="Запчасти" Width="160" HorizontalAlignment="Center" Margin="0,12,0,0" Click="PartsButton_Click"/>
                <Button x:Name="JournalButton" Grid.Row="5" Content="Журнал" Width="160" HorizontalAlignment="Center" Margin="0,12,0,0" Click="JournalButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="0"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="16"
                Padding="16">
            <Frame x:Name="MainFrame" Margin="0"/>
        </Border>
    </Grid>
</Window>

