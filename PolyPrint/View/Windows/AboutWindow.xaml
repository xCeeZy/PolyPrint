<Window x:Class="PolyPrint.View.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="О программе"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MinWidth="360"
        MinHeight="260">
    <Grid Margin="28">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="PolyPrint"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Система управления сервисным центром"
                           Style="{StaticResource CaptionTextBlockStyle}"/>

                <Separator Margin="0,20,0,16"/>

                <StackPanel>
                    <TextBlock Text="Версия приложения"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="1.0.0"
                               Margin="0,2,0,12"
                               Style="{StaticResource CaptionTextBlockStyle}"/>

                    <TextBlock Text="Разработчик"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Команда PolyPrint"
                               Margin="0,2,0,12"
                               Style="{StaticResource CaptionTextBlockStyle}"/>

                    <TextBlock Text="Контакты поддержки"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="support@polyprint.app"
                               Margin="0,2,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0">
                    <Button Content="Закрыть"
                            Width="120"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
<!--#endregion-->